rules_version = '2';

// =====================================================================
// S.D — REGRAS DE SEGURANÇA DO BANCO (firebase/firestore.rules)
// Copiar TUDO e colar em: Console do Firebase → Firestore Database → Regras → Publicar.
// Regra geral: tudo que não está liberado aqui é PROIBIDO.
//
// Coleções:
//   usuarios/{uid}        → dados da conta (cada pessoa só vê/edita a sua; adm vê todas)
//   documentos/{chave}    → "reserva" do CPF/CNPJ (chave = cpf-<11 números> ou cnpj-<14>)
//                           garante 1 conta por documento. Ninguém lê (só o adm).
// Administrador: criado como conta comum e trocado para tipo "adm" PELO CONSOLE.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções de apoio ----------
    function logado() { return request.auth != null; }
    function eDono(uid) { return logado() && request.auth.uid == uid; }
    function usuario(uid) { return /databases/$(database)/documents/usuarios/$(uid); }
    function ehAdm() { return logado() && exists(usuario(request.auth.uid)) && get(usuario(request.auth.uid)).data.tipo == 'adm'; }
    function novo() { return request.resource.data; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Campos que a própria pessoa nunca muda (tipo de conta, documento, selo de destaque...)
    function protegidos() {
      return ['tipo', 'documento', 'documentoChave', 'criadoEm', 'tags', 'avaliacao', 'servicosAnteriores', 'cargoBase'];
    }
    // O botão "destaque" é pago: só o adm liga/desliga
    function destaqueIgual() {
      return (resource.data.get('interruptores', {}).get('destaque', false))
          == (novo().get('interruptores', {}).get('destaque', false));
    }
    // Chave do documento coerente com o tipo de conta
    function chaveValida(d) {
      return (d.tipo == 'cliente-cpf' && d.documentoChave == 'cpf-' + d.documento && d.documento.matches('^[0-9]{11}$'))
          || (d.tipo in ['cliente-cnpj', 'prestador'] && d.documentoChave == 'cnpj-' + d.documento && d.documento.matches('^[0-9A-Z]{12}[0-9]{2}$'));
    }
    // Tamanho máximo de um perfil (evita abuso)
    function tamanhoOk(d) { return d.size() <= 60; }

    // ---------- usuarios/{uid} ----------
    match /usuarios/{uid} {
      allow read: if eDono(uid) || ehAdm();

      // Criar: só a própria conta, tipo permitido, e-mail igual ao do login,
      // sem campos de adm, e reservando o CPF/CNPJ no MESMO envio.
      allow create: if eDono(uid)
        && novo().tipo in ['cliente-cpf', 'cliente-cnpj', 'prestador']
        && novo().email == request.auth.token.email
        && chaveValida(novo())
        && !novo().keys().hasAny(['tags', 'avaliacao', 'servicosAnteriores', 'cargoBase'])
        && novo().get('interruptores', {}).get('destaque', false) == false
        && tamanhoOk(novo())
        && getAfter(/databases/$(database)/documents/documentos/$(novo().documentoChave)).data.uid == uid;

      // Editar: a própria pessoa (sem mexer nos protegidos; e-mail só igual ao do login)
      //         ou o adm (pode mexer em tudo, menos tipo e documento).
      allow update: if (eDono(uid)
          && !mudou().hasAny(protegidos())
          && (!mudou().hasAny(['email']) || novo().email == request.auth.token.email)
          && destaqueIgual()
          && tamanhoOk(novo()))
        || (ehAdm() && !mudou().hasAny(['tipo', 'documento', 'documentoChave']));

      // Excluir: a própria pessoa (botão "Excluir perfil") ou o adm
      allow delete: if eDono(uid) || ehAdm();
    }

    // ---------- documentos/{chave} (CPF/CNPJ único) ----------
    match /documentos/{chave} {
      allow read: if ehAdm();
      // Criar a reserva só junto com o próprio perfil. Se a chave já existir,
      // vira "alterar" → negado → o site mostra "CPF/CNPJ já cadastrado".
      allow create: if logado()
        && novo().uid == request.auth.uid
        && novo().keys().hasOnly(['uid', 'criadoEm'])
        && getAfter(usuario(request.auth.uid)).data.documentoChave == chave;
      allow update: if false;
      allow delete: if logado() && (resource.data.uid == request.auth.uid || ehAdm());
    }
  }
}
